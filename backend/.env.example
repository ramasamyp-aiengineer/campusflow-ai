# Copy to backend/.env and fill in. Never commit the real file.
# Cloud Run / Vercel: inject these as environment variables, not as source.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# sqlite path is resolved inside the backend package if unset
DATABASE_URL=

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Exact public hostnames accepted by TrustedHostMiddleware (no scheme or path)
ALLOWED_HOSTS=campusflow-api-598899050820.asia-south1.run.app,localhost,127.0.0.1,testserver

# production hides /docs and /openapi.json
ENVIRONMENT=development

# Must be set explicitly in production (even if using the hackathon demo value).
DEMO_PASSWORD=CampusFlow@2026
SESSION_HOURS=12
# Lets tests send X-Persona instead of signing in. Keep false anywhere real.
ALLOW_PERSONA_HEADER=false

# Required and non-default in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=

# Trust proxy headers only from known reverse-proxy IPs. Never use *.
FORWARDED_ALLOW_IPS=127.0.0.1
