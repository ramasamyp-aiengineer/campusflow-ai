# Copy to backend/.env and fill in. Never commit the real file.
# Cloud Run / Vercel: inject these as environment variables, not as source.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# sqlite path is resolved inside the backend package if unset
DATABASE_URL=

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# production hides /docs and /openapi.json
ENVIRONMENT=development

# Password set on the three demo accounts the first time they have none. Empty skips it.
DEMO_PASSWORD=CampusFlow@2026
SESSION_HOURS=12
# Lets tests send X-Persona instead of signing in. Keep false anywhere real.
ALLOW_PERSONA_HEADER=false
