{
  "name": "campusflow-web",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib scripts --max-warnings 0",
    "format": "prettier --write app components lib scripts",
    "format:check": "prettier --check app components lib scripts",
    "test:a11y": "node scripts/a11y-contracts.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test": "npm run typecheck && npm run lint && npm run format:check && npm run test:a11y && npm run test:unit",
    "test:ci": "npm run typecheck && npm run lint && npm run format:check && npm run test:a11y && npm run test:unit"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "jsdom": "26.1.0",
    "postcss": "8.5.24",
    "prettier": "3.6.2",
    "rollup": "npm:@rollup/wasm-node",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "overrides": {
    "postcss": "8.5.24"
  }
}
