{
  "name": "campusflow-web",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
