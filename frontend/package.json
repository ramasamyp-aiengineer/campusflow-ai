    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "postcss": "8.5.24",
    "rollup": "npm:@rollup/wasm-node",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
